{
  "name": "@swissspidy/playwright-webmcp",
  "version": "0.0.0",
  "description": "Playwright fixture, matchers, recorder and reporter for testing WebMCP tool surfaces.",
  "keywords": [
    "playwright",
    "webmcp",
    "mcp",
    "agents",
    "model-context",
    "testing",
    "fixture",
    "matchers"
  ],
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "homepage": "https://github.com/swissspidy/playwright-webmcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/playwright-webmcp.git",
    "directory": "packages/playwright"
  },
  "bugs": {
    "url": "https://github.com/swissspidy/playwright-webmcp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "dependencies": {
    "@swissspidy/webmcp-lint": "workspace:*",
    "webmcp-types": "^0.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "ai": "^7.0.102",
    "typescript": "^7.0.2"
  }
}
