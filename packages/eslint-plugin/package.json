{
  "name": "@swissspidy/eslint-plugin-webmcp",
  "version": "0.1.0",
  "description": "ESLint rules that lint WebMCP registerTool() definitions statically, using the webmcp-lint rule engine.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "webmcp",
    "lint",
    "mcp",
    "agents",
    "model-context"
  ],
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "homepage": "https://github.com/swissspidy/playwright-webmcp/tree/main/packages/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/playwright-webmcp.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/swissspidy/playwright-webmcp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "webmcp-lint": "workspace:*"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.2",
    "eslint": "^10.10.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
