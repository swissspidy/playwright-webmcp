{
  "name": "webmcp-audit",
  "version": "0.1.0",
  "description": "Crawl a site and audit its WebMCP tools: lint, smoke, contracts, cross-page drift, and an agent-readiness score.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "webmcp-audit": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "dependencies": {
    "playwright-webmcp": "workspace:*",
    "webmcp-lint": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
