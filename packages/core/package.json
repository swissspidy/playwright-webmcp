{
  "name": "webmcp-lint",
  "version": "0.1.0",
  "description": "Lint rules, snapshot model and evals-compatible call matcher for WebMCP tool surfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./collect": {
      "types": "./dist/src/collect.d.ts",
      "default": "./dist/src/collect.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'dist/test/*.test.js'"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
