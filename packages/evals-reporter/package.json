{
  "name": "playwright-webmcp-evals",
  "version": "0.1.0",
  "description": "Playwright reporter that exports scenarios recorded with playwright-webmcp as webmcp-evals cases, plus tool schemas, coverage and docs.",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "webmcp",
    "webmcp-evals",
    "mcp",
    "agents",
    "evals"
  ],
  "license": "Apache-2.0",
  "author": "Pascal Birchler",
  "homepage": "https://github.com/swissspidy/playwright-webmcp/tree/main/packages/evals-reporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/playwright-webmcp.git",
    "directory": "packages/evals-reporter"
  },
  "bugs": {
    "url": "https://github.com/swissspidy/playwright-webmcp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "dependencies": {
    "webmcp-lint": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
