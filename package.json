{
  "name": "web-agent-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm --filter webmcp-lint test",
    "test:e2e": "pnpm --filter playwright-webmcp test && pnpm --filter webmcp-audit test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
