{
  "name": "playwright-webmcp-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm --filter @swissspidy/webmcp-lint test && pnpm --filter @swissspidy/eslint-plugin-webmcp test",
    "test:e2e": "pnpm --filter @swissspidy/playwright-webmcp test && pnpm --filter @swissspidy/webmcp-audit test && pnpm --filter react-shop test",
    "test:beta": "PW_CHROMIUM=${PW_CHROMIUM:-/opt/google/chrome-beta/chrome} pnpm run test:e2e",
    "lint": "pnpm --filter react-shop lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:publish": "pnpm -r --filter './packages/*' exec publint --strict",
    "docs:rules": "node scripts/gen-rule-docs.mjs",
    "docs:rules:check": "node scripts/gen-rule-docs.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  }
}
